{
  "$schema": "https://schemas.analitiq.ai/type-map/latest.json",
  "read": [
    {
      "match": "exact",
      "native_type": "string",
      "arrow_type": "Utf8"
    },
    {
      "match": "exact",
      "native_type": "string:date",
      "arrow_type": "Date32"
    },
    {
      "match": "exact",
      "native_type": "string:date-time",
      "arrow_type": "Timestamp(MICROSECOND, UTC)"
    },
    {
      "match": "exact",
      "native_type": "string:datetime",
      "arrow_type": "Timestamp(MICROSECOND, UTC)"
    },
    {
      "match": "exact",
      "native_type": "integer",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "integer:int64",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "integer:int6",
      "arrow_type": "Int64"
    },
    {
      "match": "exact",
      "native_type": "integer:int32",
      "arrow_type": "Int32"
    },
    {
      "match": "exact",
      "native_type": "number:float",
      "arrow_type": "Float64"
    },
    {
      "match": "exact",
      "native_type": "boolean",
      "arrow_type": "Boolean"
    },
    {
      "match": "exact",
      "native_type": "object",
      "arrow_type": "Json"
    },
    {
      "match": "exact",
      "native_type": "array",
      "arrow_type": "Json"
    }
  ]
}
